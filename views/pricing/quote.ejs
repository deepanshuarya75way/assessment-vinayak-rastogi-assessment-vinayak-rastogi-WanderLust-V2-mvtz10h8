  <div>
    <h2>Price Calculator</h2>
    <form action="/listings/<%= listing._id %>/quote" method="get">
      <label for="">
        CheckIN
      </label>

      <input type="date" class="form-control" name="checkIn" required>
      <label for="">
        CheckOut
      </label>

      <input type="date" class="form-control"  name="checkOut" required>
      <label
        for="">
        Geusts
      </label>
        
        <input type="number" class="form-control" name="geusts" min="1" value="1">
        <button type="submit" class="btn btn-primary">Calculate</button>
      </form>

      <% if(quote) { %>
        <hr/>
        <h4>
          Price BreakDown
        </h4>

        <p>Nights: <%= quote.nights %></p>
        <p>Base total: Rs. <%= quote.baseTotal %></p>

        <% quote.breakdown.forEach(function(item){%>
          <div>
            <span><%= item.date %></span>
            <span><%= item.finalPrice %></span>

            <% if(item.appliedRule){%>
              <small>(<%=item.appliedRule.name%></small>
              <%}else {%>
        (No pricing changes)
        <%}%>
          </div>
        <% })%>
        
        <h3>Total: Rs. <%=quote.total%></h3>
      <%} %>
  </div>