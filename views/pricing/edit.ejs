<% layout("/layouts/boilerplate") %>

<% const conditions = rule.conditions ||{};
const formatDate = (date)=>date?new Date(date).toISOString().slice(0, 10):''
%>

  <div class="row mt-3">
    <div class="col-8 offset-2">
      <br><br>
      <h3>Create Pricing Rule</h3>

      <p>Listing : <strong>
          <%=listing.title%>
        </strong></p>

      <form method="POST" action="/listings/<%=listing._id%>/pricing-rules/<%= rule._id %>?_method=PUT" novalidate class="needs-validation">
        <div class="mb-3">
          <label for="title" class="form-label">Rule Name</label>
          <input id="title" type="text" value="<%=rule.name%>" name="name" placeholder="Enter title" class="form-control" required>
        </div>


        <div class="mb-3">
          <label class="form-label">Adjustment Type</label>
          <select name="adjustmentType" class="form-select" required>
            <option value="percentageIncrease">Percentage Increase</option>
            <option value="percentageDiscount">Percentage Discount</option>
            <option value="fixedIncrese">Fixed Increse</option>
            <option value="fixedDiscount">Fixed Discount</option>
          </select>
        </div>

        <div class="mb-3">
          <label class="form-label">Adjustment Value</label>
          <input type="number" value="<%=rule.value%>" name="value" min="0" step="0.01" class="form-control" required>
        </div>

        <div class="mb-3">
          <label class="form-label">Priority</label>
          <input name="priority" class="form-control" value="<%= rule.priority %>" required>
        </div>

        <hr>

        <h4>Conditions</h4>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">Start Date</label>
            <input  value="<%= formatDate(conditions.startDate) %>" type="date" name="conditions[startDate]" class="form-control" >
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">End Date</label>
            <input value="<%= formatDate(conditions.endDate) %>" type="date" name="conditions[endDate]" class="form-control">
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Min Nights</label>
            <input value="<%= conditions?.minNights|| ''%>" type="number" min="1" name="conditions[minNights]" class="form-control">
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Max Nights</label>
            <input type="number" value="<%= conditions?.maxNights|| ''%>" min="1" name="conditions[maxNights]" class="form-control">
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">min Geusts</label>
            <input type="number" value="<%= conditions?.minGeusts|| ''%>" min="1" name="conditions[minGeusts]" class="form-control">
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Max Geusts</label>
            <input type="number" value="<%= conditions?.maxGeusts|| ''%>" min="1" name="conditions[maxGeusts]" class="form-control">
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Min Advance Days</label>
            <input type="number" value="<%= conditions?.minAdvanceDays|| ''%>" min="1" name="conditions[minAdvanceDays]" class="form-control">
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">Max Advance Days</label>
            <input type="number" value="<%= conditions?.maxAdvanceDays| ''%>" min="1" name="conditions[maxAdvanceDays]" class="form-control">
          </div>
        </div>

        <button type="submit" class="btn btn-primary">
          Update rule
        </button>

        <a href="/listings/<%= listing._id %>/pricing-rules" class="btn btn-primary">Cancel</a>
      </form>
    </div>
  </div>