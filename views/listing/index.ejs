<% layout("/layouts/boilerplate") %>
    

<style>
  .filters-wrapper {
      display: flex;
      flex-wrap: wrap;
  }
  .hello{
     display: flex;
      flex-wrap: wrap;
      align-items: center;

  }

  .filter {
      text-align: center;
      margin-right: 2rem;
      margin-top: 2rem;
      opacity: 0.7;
  }

  .filter.active{
    opacity: 1;
    text-decoration: underline !important; 
  }

  .filter:hover {
      opacity: 1;
      cursor: pointer;
      text-decoration: underline;
  }

  .filter{
      font-size: 0.8rem;
      margin-top: 0.3rem;
  }

  #toggle {
      margin-top: 1rem;
      border: 1px solid black;
      height: 3rem;
      border-radius: 10px;
      padding: 2rem 1rem 1rem 1rem;
      margin-left: 5rem;
      display: flex;
      align-items: center;
    }

  #toggle p,input{
    cursor: pointer;
  }

  

  .tax-info{
    display: none;
    
  }
</style>

<div class="container">

  <!-- Button + Toggle -->
  <div class="d-flex align-items-center gap-4 hello">
    <div class="btn-group">
      <button type="button" class="btn btn-outline-dark dropdown-toggle mt-3" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        
        <% if (sort==='names_asc') { %>
          <i class="fa-solid fa-arrow-down-a-z"></i>
          Name Ascending
        <% } else if (sort==='names_desc') { %>
          <i class="fa-solid fa-arrow-down-z-a"></i>
          Name Descending 
        <% } else if (sort==='price_desc') { %>
          <i class="fa-solid fa-arrow-down-9-1"></i>
          Price Descending
        <% } else if(sort==='price_asc'){ %>
          <i class="fa-solid fa-arrow-down-1-9"></i>
          Price Ascending
        <% } else { %>
          <i class="fa-solid fa-sort"></i>
          Sort
        <% } %>
      </button>
      <div class="dropdown-menu mt-3 text-center shadow-lg">
        <a class="dropdown-item text-center" href="/listings?sort=names_asc<%= search? '&search=' + encodeURIComponent(search):'' %><%= selectedCategory ? '&category=' + encodeURIComponent(selectedCategory) : '' %><%= minPrice? '&minPrice='+encodeURIComponent(minPrice):''%><%= maxPrice? '&maxPrice='+encodeURIComponent(maxPrice):''%>">Name Ascending <i class="fa-solid fa-arrow-down-a-z"></i></a>
        <a class="dropdown-item text-center" href="/listings?sort=names_desc<%= search? '&search=' + encodeURIComponent(search):'' %><%= selectedCategory ? '&category=' + encodeURIComponent(selectedCategory) : '' %><%= minPrice? '&minPrice='+encodeURIComponent(minPrice):''%><%= maxPrice? '&maxPrice='+encodeURIComponent(maxPrice):''%>">Name Descending <i class="fa-solid fa-arrow-down-z-a"></i></a>
        <a class="dropdown-item text-center" href="/listings?sort=price_asc<%= search? '&search=' + encodeURIComponent(search):'' %><%= selectedCategory ? '&category=' + encodeURIComponent(selectedCategory) : '' %><%= minPrice? '&minPrice='+encodeURIComponent(minPrice):''%><%= maxPrice? '&maxPrice='+encodeURIComponent(maxPrice):''%>">Price Ascending <i class="fa-solid fa-arrow-down-1-9"></i></a>
        <a class="dropdown-item text-center" href="/listings?sort=price_desc<%= search? '&search=' + encodeURIComponent(search):'' %><%= selectedCategory ? '&category=' + encodeURIComponent(selectedCategory) : '' %><%= minPrice? '&minPrice='+encodeURIComponent(minPrice):''%><%= maxPrice? '&maxPrice='+encodeURIComponent(maxPrice):''%>">Price Descending <i class="fa-solid fa-arrow-down-9-1"></i></a>
      </div>
    </div>


    
       <% if (minPrice||maxPrice) { %>
        <a class="btn btn-outline-dark mt-3" href="/listings?<%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):''%>"><i class="fa-solid fa-filter-circle-xmark"></i> &nbsp;Clear Filters</a>
       <% } else {%>
        <a class="btn btn-outline-dark mt-3"
       data-bs-toggle="collapse"
       href="#collapseExample"
       role="button"
       aria-expanded="false"
       aria-controls="collapseExample">
        <i class="fa-solid fa-filter"></i> Filters
        </a>
        <% } %>
    

    <div id="toggle" class="ms-auto btn btn-outline-dark">
      <div class="form-check form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault">
          <p>Price with Taxes</p>
        </label>
      </div>
    </div>
  </div>

  <!-- COLLAPSE -->
   <div class="collapse mt-3" id="collapseExample">
    <form action="/listings" method="get">

      <%if(search){%>
        <input type="hidden" name="search" value="<%= search %>">
      <%}%>

      <%if(sort){%>
        <input type="hidden" name="sort" value="<%= sort %>">
      <%}%>

      <%if(selectedCategory){%>
        <input type="hidden" name="category" value="<%= selectedCategory %>">
      <%}%>

      <div class="d-flex justify-content-between">
        <div class="">
          <label for="minPrice" class="form-label">Min Price</label>
          <input type="number" name="minPrice" class="form-control" id="minPrice" min="100" max="15000" value="<%= minPrice?? '' %>">
        </div>
        <div class="">
          <label for="maxPrice" class="form-label">Max Price</label>
          <input type="number" name="maxPrice" class="form-control" id="maxPrice" min="100" max="15000" value="<%= maxPrice?? '' %>">
        </div>

        <button class="btn btn-outline-dark d-flex h-25 mt-4 align-items-center" type="submit">
          Apply Filter
        </button>
      </div>
    </form>
</div>

    <div class="filters-wrapper mt-4 align-items-center">

      <a href="/listings?category=Rooms<%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %><%= minPrice? '&minPrice='+encodeURIComponent(minPrice):''%><%= maxPrice? '&maxPrice='+encodeURIComponent(maxPrice):''%>" class="filter card-body text-decoration-none <%= selectedCategory === 'Rooms' ? 'active' : '' %>">
        <i class="fa-solid fa-bed"></i>
        <p>Rooms</p>
      </a>

      <a href="/listings?category=Iconic%20Cities<%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %><%= minPrice? '&minPrice='+encodeURIComponent(minPrice):''%><%= maxPrice? '&maxPrice='+encodeURIComponent(maxPrice):''%>" class="filter card-body text-decoration-none <%= selectedCategory === 'Iconic Cities' ? 'active' : '' %>">
        <i class="fa-solid fa-mountain-city"></i>
        <p>Iconic Cities</p>
      </a>

      <a href="/listings?category=Mountains<%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %><%= minPrice? '&minPrice='+encodeURIComponent(minPrice):''%><%= maxPrice? '&maxPrice='+encodeURIComponent(maxPrice):''%>" class="filter card-body text-decoration-none <%= selectedCategory === 'Mountains' ? 'active' : '' %>">
        <i class="fa-solid fa-mountain"></i>
        <p>Mountains</p>
      </a>

      <a href="/listings?category=Lakefront<%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %><%= minPrice? '&minPrice='+encodeURIComponent(minPrice):''%><%= maxPrice? '&maxPrice='+encodeURIComponent(maxPrice):''%>" class="filter card-body text-decoration-none <%= selectedCategory === 'Lakefront' ? 'active' : '' %>">
        <i class="fa-solid fa-water"></i>
        <p>Lakefront</p>
      </a>

      <a href="/listings?category=Amazing%20Pools<%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %><%= minPrice? '&minPrice='+encodeURIComponent(minPrice):''%><%= maxPrice? '&maxPrice='+encodeURIComponent(maxPrice):''%>" class="filter card-body text-decoration-none <%= selectedCategory === 'Amazing Pools' ? 'active' : '' %>">
        <i class="fa-solid fa-water-ladder"></i>
        <p>Amazing Pools</p>
      </a>

      <a href="/listings?category=Amazing%20Views<%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %><%= minPrice? '&minPrice='+encodeURIComponent(minPrice):''%><%= maxPrice? '&maxPrice='+encodeURIComponent(maxPrice):''%>" class="filter card-body text-decoration-none <%= selectedCategory === 'Amazing Views' ? 'active' : '' %>">
        <i class="fa-solid fa-binoculars"></i>
        <p>Amazing Views</p>
      </a>

      <a href="/listings?category=Beach<%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %><%= minPrice? '&minPrice='+encodeURIComponent(minPrice):''%><%= maxPrice? '&maxPrice='+encodeURIComponent(maxPrice):''%>" class="filter card-body text-decoration-none <%= selectedCategory === 'Beach' ? 'active' : '' %>">
        <i class="fa-solid fa-umbrella-beach"></i>
        <p>Beach</p>
      </a>

      <a href="/listings?category=Castles<%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %><%= minPrice? '&minPrice='+encodeURIComponent(minPrice):''%><%= maxPrice? '&maxPrice='+encodeURIComponent(maxPrice):''%>" class="filter card-body text-decoration-none <%= selectedCategory === 'Castles' ? 'active' : '' %>">
        <i class="fa-brands fa-fort-awesome"></i>
        <p>Castles</p>
      </a>

      <a href="/listings?category=Cabin<%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %><%= minPrice? '&minPrice='+encodeURIComponent(minPrice):''%><%= maxPrice? '&maxPrice='+encodeURIComponent(maxPrice):''%>" class="filter card-body text-decoration-none <%= selectedCategory === 'Cabin' ? 'active' : '' %>">
        <i class="fa-solid fa-house-chimney"></i>
        <p>Cabin</p>
      </a>

      <a href="/listings?category=Camp<%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %><%= minPrice? '&minPrice='+encodeURIComponent(minPrice):''%><%= maxPrice? '&maxPrice='+encodeURIComponent(maxPrice):''%>" class="filter card-body text-decoration-none <%= selectedCategory === 'Camp' ? 'active' : '' %>">
        <i class="fa-solid fa-campground"></i>
        <p>Camp</p>
      </a>

      <a href="/listings?category=Farms<%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %><%= minPrice? '&minPrice='+encodeURIComponent(minPrice):''%><%= maxPrice? '&maxPrice='+encodeURIComponent(maxPrice):''%>" class="filter card-body text-decoration-none <%= selectedCategory === 'Farms' ? 'active' : '' %>">
        <i class="fa-solid fa-tractor"></i>
        <p>Farms</p>
      </a>

      <a href="/listings?category=Snow<%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %><%= minPrice? '&minPrice='+encodeURIComponent(minPrice):''%><%= maxPrice? '&maxPrice='+encodeURIComponent(maxPrice):''%>" class="filter card-body text-decoration-none <%= selectedCategory === 'Snow' ? 'active' : '' %>">
        <i class="fa-solid fa-snowman"></i>
        <p>Snow</p>
      </a>

      <% if (selectedCategory) { %>
       <a href="/listings?<%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %><%= minPrice? '&minPrice='+encodeURIComponent(minPrice):''%><%= maxPrice? '&maxPrice='+encodeURIComponent(maxPrice):''%>" class="filter card-body text-decoration-none text-danger h-25">
        <i class="fa-solid fa-xmark"></i>
        <p>Clear</p>
      </a>
      <% } %>

    </div>

</div>
    

    <% if (allListing.length === 0) { %>
  <div class="container text-center mt-5">
    <h4>No listings found</h4>
    <p>Try searching with a different destination.</p>
    <a href="/listings" class="btn btn-outline-dark">
      Clear Search
    </a>
  </div>
<% } else { %>
  <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1 mt-5 mb-3">
    <% for (let listing of allListing) { %>
      <a href="/listings/<%= listing._id %>" class="listing-links">
        <div class="card col listing-card">
          <img
            src="<%= listing.image.url %>"
            class="card-img-top"
            alt="listing_image"
            style="height: 15rem"
          />

          <div class="card-img-overlay"></div>

          <div class="card-body">
            <p class="card-text">
              <b><%= listing.title %></b>
              <br />

              <% if (typeof listing.price === "number") { %>
                &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
                <i class="tax-info">&nbsp;&nbsp;+18% GST</i>
              <% } %>
            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>
  <!-- Pagination -->
  <div>
    <nav aria-label="Page navigation example">
      <ul class="pagination justify-content-center">
        <% if (page>1) { %>
          <li class="page-item">
            <a class="page-link" href="/listings?page=<%=page-1%><%= selectedCategory? '&category=' + encodeURIComponent(selectedCategory):'' %><%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %>" tabindex="-1">&laquo;</a>
          </li>
        <% } %>
        <li class="page-item active">
          <a class="page-link text-decoration-none" href="/listings?page=<%=page%><%= selectedCategory? '&category=' + encodeURIComponent(selectedCategory):'' %><%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %>"><%= page %></a>
        </li>

        <% if (page<totPages) { %>
          <li class="page-item"><a class="page-link text-decoration-none" href="/listings?page=<%=page+1%><%= selectedCategory? '&category=' + encodeURIComponent(selectedCategory):'' %><%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %>"><%= page + 1 %></a></li>
        <% } %>

        <% if (page+1<totPages) { %>
          <li class="page-item">
            <a class="page-link text-decoration-none" href="/listings?page=<%=page+2 %><%= selectedCategory? '&category=' + encodeURIComponent(selectedCategory):'' %><%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %>"><%= page + 2 %></a>
          </li>
        <% } %>

        <% if (page<totPages-1) { %>
         <li class="page-item">
          <a class="page-link" href="/listings?page=<%=page+1%><%= selectedCategory? '&category=' + encodeURIComponent(selectedCategory):'' %><%= search? '&search='+encodeURIComponent(search):'' %><%= sort? '&sort='+encodeURIComponent(sort):'' %>">&raquo;</a>
        </li>
        <% } %>
      </ul>
    </nav>
  </div>

<% } %>


<script> 
    let priceToggle = document.getElementById("switchCheckDefault")
    priceToggle.addEventListener("click",()=>{
        let taxInfo = document.getElementsByClassName("tax-info");

        for(info of taxInfo){
            if(info.style.display != "inline"){
                info.style.display= "inline"
            }else{
                info.style.display= "none"
            }
        }
    })
</script>